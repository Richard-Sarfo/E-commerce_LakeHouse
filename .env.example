# Copy this file to .env and fill in the real values.
# .env is gitignored and never leaves your machine.
#
# Used by the Docker-based Terraform and aws-cli invocations
# documented in DEPLOYMENT.md and the Makefile.

# ── AWS credentials (IAM user — never root) ─────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA__REPLACE_ME__
AWS_SECRET_ACCESS_KEY=__REPLACE_ME__
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# ── Terraform variables ─────────────────────────────────────────────────────
# Email subscribed to the SNS pipeline-failure topic. Confirmation
# email arrives when terraform apply first creates the subscription.
TF_VAR_alert_email=you@example.com

# Override the default us-east-1 if your account lives elsewhere.
TF_VAR_aws_region=us-east-1
