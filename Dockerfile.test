# Test environment — runs the P2 unit suite inside an Apache Spark + Delta Lake container.
# Not used in production; consumed only by `docker compose -f docker-compose.test.yml run --rm tests`.

FROM apache/spark:3.5.0-python3

USER root

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYSPARK_PYTHON=python3
ENV PYSPARK_DRIVER_PYTHON=python3

RUN pip install --no-cache-dir \
        "pyspark==3.5.0" \
        "delta-spark==3.1.0" \
        pytest==8.3.0 \
        ruff==0.6.9

WORKDIR /work
